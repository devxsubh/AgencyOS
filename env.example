# =============================================================================
# WONDER CREATIVE STUDIOS - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------

# MongoDB Connection String
# For local development: mongodb://localhost:27017/wonder-creative-studios
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URI=mongodb://localhost:27017/wonder-creative-studios

# -----------------------------------------------------------------------------
# CLOUDINARY (Image/Media Management)
# -----------------------------------------------------------------------------
# Get credentials from: https://cloudinary.com/console
# Used for uploading and managing images for blogs and portfolios

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# -----------------------------------------------------------------------------
# OPENAI (AI Content Generation)
# -----------------------------------------------------------------------------
# Get API key from: https://platform.openai.com/api-keys
# Used for AI-powered blog content generation and chatbot functionality

OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# -----------------------------------------------------------------------------
# AUTHENTICATION (Admin Panel)
# -----------------------------------------------------------------------------
# Server-side only. NEVER prefix these with NEXT_PUBLIC_ (that ships them to the browser).
# SESSION_SECRET signs the admin session cookie. Generate one with: openssl rand -base64 48

ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change_this_to_a_long_random_password
SESSION_SECRET=generate_with_openssl_rand_base64_48_at_least_32_chars

# -----------------------------------------------------------------------------
# ANALYTICS & TRACKING
# -----------------------------------------------------------------------------

# Google Analytics Measurement ID
# Get from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-GEYE331BP3

# Meta (Facebook) Pixel ID
# Get from: https://business.facebook.com/events_manager
# Format: numeric ID
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id

# -----------------------------------------------------------------------------
# VERCEL KV (Optional - Key-Value Storage)
# -----------------------------------------------------------------------------
# Used for caching and session storage
# Get from: https://vercel.com/dashboard/stores

KV_REST_API_URL=https://your-kv-store.kv.vercel-storage.com
KV_REST_API_TOKEN=your_kv_rest_api_token

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------

# Node Environment (development | production | test)
NODE_ENV=development

# Application URL (used for absolute URLs in emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Base URL (optional, defaults to same origin)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (Optional - for future use)
# -----------------------------------------------------------------------------
# SMTP settings for sending emails (contact form, notifications, etc.)

# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_app_specific_password
# EMAIL_FROM=noreply@wondercreativestudios.com

# -----------------------------------------------------------------------------
# THIRD-PARTY INTEGRATIONS (Optional)
# -----------------------------------------------------------------------------

# Stripe (for payment processing)
# STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# SendGrid (alternative email service)
# SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Twilio (for SMS notifications)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------------------------------------------------------
# FEATURE FLAGS (Optional)
# -----------------------------------------------------------------------------
# Toggle features on/off without code changes

# NEXT_PUBLIC_FEATURE_CHATBOT=true
# NEXT_PUBLIC_FEATURE_BLOG_COMMENTS=false
# NEXT_PUBLIC_FEATURE_PORTFOLIO_FILTER=true

# -----------------------------------------------------------------------------
# RATE LIMITING (Optional - for production)
# -----------------------------------------------------------------------------

# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=900000

# -----------------------------------------------------------------------------
# SENTRY (Error Tracking - Optional)
# -----------------------------------------------------------------------------
# Get from: https://sentry.io/

# NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
# SENTRY_ORG=your_organization
# SENTRY_PROJECT=your_project
# SENTRY_AUTH_TOKEN=your_sentry_auth_token

# -----------------------------------------------------------------------------
# LOGGING (Optional)
# -----------------------------------------------------------------------------

# LOG_LEVEL=info
# LOG_FILE=./logs/application.log

# -----------------------------------------------------------------------------
# SESSION CONFIGURATION
# -----------------------------------------------------------------------------

# Session secret for cookie signing (generate a secure random string)
# SESSION_SECRET=your_very_secure_random_string_here

# Session expiry in seconds (default: 7 days)
# SESSION_MAX_AGE=604800

# -----------------------------------------------------------------------------
# NOTES
# -----------------------------------------------------------------------------
# 1. All NEXT_PUBLIC_* variables are exposed to the browser
# 2. Never commit sensitive credentials to version control
# 3. Use strong passwords and API keys in production
# 4. Rotate API keys and secrets regularly
# 5. For production, use environment variables from your hosting provider
# 6. MongoDB Atlas IP whitelist must include your deployment server
# 7. Cloudinary has storage limits on free tier
# 8. OpenAI API has rate limits and costs per token
# =============================================================================
