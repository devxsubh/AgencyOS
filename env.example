# Copy to .env.local and fill in. Never commit real values.

# MongoDB (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/wonder-creative-studios

# Admin login (server-side only; never prefix with NEXT_PUBLIC_)
# ADMIN_USERNAME must be an email. Generate SESSION_SECRET with: openssl rand -base64 48
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change_this_to_a_long_random_password
SESSION_SECRET=generate_with_openssl_rand_base64_48_at_least_32_chars

# Chatbot + blog generation: free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash

# Cloudinary unsigned uploads from the admin panel (needs an unsigned preset named "blog-thumbnails")
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
